# ==============================================================================
# BrandSentinel Environment Configuration Template (.env.example)
#
# IMPORTANT SECURITY DIRECTIVES:
# 1. This file contains PLACEHOLDERS ONLY. Do NOT enter real secrets here.
# 2. Never commit .env files with real credentials to version control.
# 3. In production, provide secrets using your cloud platform's secret manager
#    (e.g., AWS Secrets Manager, GCP Secret Manager, Azure Key Vault, HashiCorp Vault).
# 4. Never prefix secrets with NEXT_PUBLIC_* or VITE_* to prevent browser exposure.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
# Environment: 'development', 'test', 'staging', or 'production'
# Default: development
APP_ENV=development

# Server Secret Key: REQUIRED in production (minimum 32 characters long).
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
# Startup will FAIL SAFELY in production if SECRET_KEY is missing or weak.
SECRET_KEY=placeholder-min-32-chars-hex-string-for-session-and-csrf-protection

# Database Connection URL:
# Development default: sqlite:///data/brandsentinel.db
# Production example: postgresql+psycopg2://brandsentinel_user:placeholder_password@db-host:5432/brandsentinel
DATABASE_URL=sqlite:///data/brandsentinel.db

# Server Binding
HOST=0.0.0.0
PORT=5000

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. OPTIONAL TELEMETRY CONNECTOR CREDENTIALS
#
# NOTE: Missing optional settings will safely DISABLE that connector without
# causing application startup failure. In development, unconfigured connectors
# operate in mock sandbox mode.
# ------------------------------------------------------------------------------

# Meta / Instagram Graph API
INSTAGRAM_CLIENT_ID=placeholder_instagram_client_id
INSTAGRAM_CLIENT_SECRET=placeholder_instagram_client_secret

# X (Twitter) API v2
TWITTER_API_KEY=placeholder_twitter_api_key
TWITTER_API_SECRET=placeholder_twitter_api_secret
TWITTER_BEARER_TOKEN=placeholder_twitter_bearer_token

# Apple App Store Connect API
APPLE_KEY_ID=placeholder_apple_key_id
APPLE_TEAM_ID=placeholder_apple_team_id
APPLE_PRIVATE_KEY=placeholder_apple_p8_private_key_content

# Google Play Developer API
# Store JSON service account credentials in secret manager or pass base64
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=placeholder_service_account_json_content

# TikTok for Business API
TIKTOK_APP_ID=placeholder_tiktok_app_id
TIKTOK_SECRET=placeholder_tiktok_app_secret

# Global Domain Registry & DNS Telemetry Stream
DOMAIN_FEED_API_KEY=placeholder_domain_registry_api_key

# YouTube Data API v3 (Deployment-level fallback API Key)
YOUTUBE_API_KEY=placeholder_youtube_api_key

# Managed Credential Vault Encryption Key (Kept separately from database)
# Required in production. Generate using: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CREDENTIAL_ENCRYPTION_KEY=placeholder_credential_vault_encryption_key_base64_min_32_bytes
